[Unit]
Description=Cirne Rotas - atualizar clientes as 06h e 13h de Sao Paulo

[Timer]
OnCalendar=*-*-* 06:00:00 America/Sao_Paulo
OnCalendar=*-*-* 13:00:00 America/Sao_Paulo
AccuracySec=1s
RandomizedDelaySec=0
# No surprise imports at boot after a missed slot. Use Atualizar agora for recovery.
Persistent=false
Unit=cirne-client-sync.service

[Install]
WantedBy=timers.target
