[Unit]
Description=Cirne Rotas - sincronizacao da base Google Sheets
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=cirne-ops
Group=cirne-ops
WorkingDirectory=/opt/cirne-rotas/ops
EnvironmentFile=/etc/cirne-rotas/client-sync.env
ExecStart=/usr/bin/npm run ops:client-sync -- --scheduled --json
TimeoutStartSec=120
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
StandardOutput=journal
StandardError=journal
