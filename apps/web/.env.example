# Copy to apps/web/.env.local. Existing root .env belongs to previous tooling.
APP_BASE_URL=http://127.0.0.1:3000
OPERATIONAL_TIME_ZONE=America/Sao_Paulo
LOG_LEVEL=info
# health/live remains independent of Supabase. Identity routes require only
# caller-scoped public connection values; never place a secret/service key here.
# Para confirmar bytes de evidências, injete CIRNE_SUPABASE_VERIFIER_KEY somente
# no processo servidor em produção. O ambiente local usa .local/supabase-verifier.json
# criado pelo provisionamento sintético; não copie a chave para este arquivo.
SUPABASE_PUBLIC_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key

# Evidências ficam no dispositivo até o Storage privado e o backup serem validados.
EVIDENCE_REMOTE_SYNC_ENABLED=false
EVIDENCE_STORAGE_BUCKET=visit-evidence
