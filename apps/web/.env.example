# Copy to apps/web/.env.local. Existing root .env belongs to previous tooling.
APP_BASE_URL=http://127.0.0.1:3000
OPERATIONAL_TIME_ZONE=America/Sao_Paulo
LOG_LEVEL=info
# health/live remains independent of Supabase. Identity routes require only
# caller-scoped public connection values; never place a secret/service key here.
# Para confirmar bytes de evidências, injete CIRNE_SUPABASE_VERIFIER_KEY somente
# no processo servidor em produção. O ambiente local usa .local/supabase-verifier.json
# criado pelo provisionamento sintético; não copie a chave para este arquivo.
SUPABASE_PUBLIC_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key

# Evidências ficam no dispositivo até o Storage privado e o backup serem validados.
EVIDENCE_REMOTE_SYNC_ENABLED=false
EVIDENCE_STORAGE_BUCKET=visit-evidence

# Google Sheets: only the server reads these values. Never use NEXT_PUBLIC_*.
# Keep disabled until credentials, portfolio mapping and real-data gates are ready.
GOOGLE_CLIENT_SYNC_ENABLED=false
GOOGLE_CLIENT_SYNC_SPREADSHEET_ID=
GOOGLE_CLIENT_SYNC_SERVICE_ACCOUNT_EMAIL=
GOOGLE_CLIENT_SYNC_PRIVATE_KEY=
# JSON mapping portfolio labels to actual authorized seller login emails; {} leaves all pending.
GOOGLE_CLIENT_SYNC_PORTFOLIOS_JSON={}
GOOGLE_CLIENT_SYNC_SCHEDULE_ENABLED=false
GOOGLE_CLIENT_SYNC_SCHEDULER_ACTOR_ID=

# Vendas: separate, private one-shot CLI acquisition; never use NEXT_PUBLIC_*.
# Remains disabled until Google access, DB actor binding and real-data gates pass.
GOOGLE_SALES_SYNC_ENABLED=false
GOOGLE_SALES_SYNC_SPREADSHEET_ID=
GOOGLE_SALES_SYNC_SCHEDULE_ENABLED=false
GOOGLE_SCRAP_SYNC_ENABLED=false
GOOGLE_SCRAP_SYNC_SPREADSHEET_ID=1oLs33Sh0RRXQ1BYqvAIVq5uZwLGiLYTn4m_92Ql6cFo
GOOGLE_SCRAP_SYNC_PUBLIC_READ=true
GOOGLE_SCRAP_SYNC_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SCRAP_SYNC_PRIVATE_KEY=
GOOGLE_SCRAP_SYNC_SCHEDULE_ENABLED=false
GOOGLE_SCRAP_SYNC_SCHEDULER_ACTOR_ID=
GOOGLE_SALES_SYNC_SCHEDULER_ACTOR_ID=
# CLI host only (not a browser token or service_role); freshly authenticates each run.
# Do not populate these Google/login credentials in the web process.
GOOGLE_SALES_SYNC_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SALES_SYNC_PRIVATE_KEY=
CIRNE_SALES_SYNC_EMAIL=
CIRNE_SALES_SYNC_PASSWORD=

# Catálogo oficial do mini CRM: fonte/ator próprios, atualização somente manual nesta versão.
# Não reutilize autorização, identidade ou credenciais das integrações de clientes/vendas.
GOOGLE_PRODUCT_CATALOG_ENABLED=false
GOOGLE_PRODUCT_CATALOG_SPREADSHEET_ID=
GOOGLE_PRODUCT_CATALOG_ACTOR_ID=
# CLI host only. O processo web não precisa destas credenciais Google/login.
GOOGLE_PRODUCT_CATALOG_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRODUCT_CATALOG_PRIVATE_KEY=
CIRNE_PRODUCT_CATALOG_SYNC_EMAIL=
CIRNE_PRODUCT_CATALOG_SYNC_PASSWORD=
